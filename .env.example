BOT_TOKEN=
# Опционально: HTTP-прокси для всех внешних запросов бота — Telegram, ИИ, распознавание
# голоса (например, mixed-порт Hiddify: http://127.0.0.1:12334). Пусто — напрямую.
PROXY_URL=
ANTHROPIC_API_KEY=
# Опционально: Anthropic-совместимый прокси вместо api.anthropic.com (например,
# https://customix.fun/api). Пусто — используется официальный endpoint Anthropic,
# и берётся ключ из ANTHROPIC_API_KEY.
ANTHROPIC_BASE_URL=
# Ключ для прокси из ANTHROPIC_BASE_URL. Используется вместо ANTHROPIC_API_KEY,
# когда ANTHROPIC_BASE_URL задан.
CUSTOMIX_API_KEY=
# Опционально: модель для анализа фото. По умолчанию — claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5
# Для распознавания голосовых сообщений (OpenAI Whisper API).
OPENAI_API_KEY=
# Опционально: OpenAI-совместимый прокси вместо api.openai.com (например,
# https://api.apibazaar.shop/v1). Пусто — используется официальный endpoint OpenAI.
OPENAI_BASE_URL=
INVITE_CODES=letmein,family2026
DB_PATH=./data/db.sqlite
DEFAULT_TIMEZONE=Europe/Moscow
# Время ежедневной вечерней сводки (HH:MM, в DEFAULT_TIMEZONE).
EVENING_SUMMARY_TIME=23:30
# Время недельного отчёта по воскресеньям (HH:MM, в DEFAULT_TIMEZONE).
WEEKLY_REPORT_TIME=21:00
# Время ежедневной проверки напоминания о весе (HH:MM, в DEFAULT_TIMEZONE): если вес
# не обновлялся неделю, бот попросит его записать (не чаще раза в неделю).
WEIGHT_REMINDER_TIME=09:00
# Напоминания о пропущенном обеде/ужине (true — включить). По умолчанию выключены.
MEAL_REMINDERS_ENABLED=false
